# Copy to .env and fill in. Check it with: node scripts/check-env.mjs
# Every variable is read at runtime except NEXT_PUBLIC_*, which Next.js fixes when the app is built.

# --- Required ---------------------------------------------------------------
# MongoDB: Atlas (mongodb+srv://...) or the Docker Compose database below
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/openstock?retryWrites=true&w=majority
# Signs sessions. Generate with: openssl rand -hex 32  (the app refuses to run auth in production without it)
BETTER_AUTH_SECRET=
# Public URL of the app, used in auth callbacks and email links
BETTER_AUTH_URL=http://localhost:3000
# Optional Finnhub key. Without a key, quotes, search and news use the Yahoo Finance fallback.
FINNHUB_API_KEY=
# FINNHUB_API_KEYS=key_one,key_two

# --- Market data ------------------------------------------------------------
# "delayed" (default): 5-minute shared quote cache; "cached": hourly; "realtime": Finnhub every 15 seconds.
# Fixed at build time: rebuild after changing it (docker compose passes it to the build).
NEXT_PUBLIC_OPENSTOCK_DATA_MODE=delayed
# In-app alerts check every minute while a signed-in page is visible. No email is sent in this mode.
# This deployment supports "in-app" and "off"; the email scheduler has been retired.
NEXT_PUBLIC_OPENSTOCK_ALERT_MODE=in-app

# --- Optional password-reset email --------------------------------------------
# Used only for password recovery; marketing emails and AI digests are disabled.
# NODEMAILER_EMAIL=
# NODEMAILER_PASSWORD=

# --- Social sign-in -----------------------------------------------------------
# Each provider turns on only when its ID is set. Callbacks: <BETTER_AUTH_URL>/api/auth/callback/google and /github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Docker Compose only ------------------------------------------------------
# Root password for the bundled MongoDB; use the same one in MONGODB_URI, e.g.
# MONGODB_URI=mongodb://root:<password>@mongodb:27017/openstock?authSource=admin
# MONGO_ROOT_PASSWORD=

# Google OAuth production setup for this deployment:
# Authorized JavaScript origin: https://openstock-zh-five.vercel.app
# Authorized redirect URI: https://openstock-zh-five.vercel.app/api/auth/callback/google
# Configure GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET privately in Vercel.
# Also set MONGODB_URI, BETTER_AUTH_SECRET and BETTER_AUTH_URL before enabling sign-in.
